<?xml version="1.0"?>
<Container version="2">
  <Name>stromleser</Name>
  <Repository>ghcr.io/itnorgeconsult/stromleser:latest</Repository>
  <Registry>https://github.com/ITNorgeConsult/stromleser/pkgs/container/stromleser</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <ExtraParams>--user 99:100</ExtraParams>
  <Support>https://github.com/ITNorgeConsult/stromleser/issues</Support>
  <Project>https://github.com/ITNorgeConsult/stromleser</Project>
  <Overview>Strømleser samler solcelleanlegg, AMS-måler, elbilladere og biler i ett grensesnitt, og regner ut hva strømmen faktisk koster.</Overview>
  <Category>HomeAutomation: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/ITNorgeConsult/stromleser/main/web/static/favicon.svg</Icon>
  <Config Name="Web-port" Target="8080" Default="8080" Mode="tcp" Type="Port" Display="always" Required="true">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/stromleser" Mode="rw" Type="Path" Display="always" Required="true">/mnt/user/appdata/stromleser</Config>
  <Config Name="Plattform" Target="STROMLESER_PLATFORM" Default="unraid" Type="Variable" Display="advanced" Required="false">unraid</Config>
  <Config Name="Tidssone" Target="TZ" Default="Europe/Oslo" Type="Variable" Display="advanced" Required="false">Europe/Oslo</Config>
</Container>
